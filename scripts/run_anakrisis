#!/bin/sh
# The public command for anakrisis, whose implementation is the child project's
# own: tools/anakrisis/anakrisis.sh. This launcher exists because commands live
# at the repository root and a child's implementation stays in its directory --
# kanon's docs/policy.md, "Tool and feature directories".
#
# It resolves its own symlinks before locating the implementation, so a symlink
# to this file from anywhere on PATH works. Reading $0 alone did not: a symlink
# in ~/bin made $HERE that directory and the exec failed on a path that never
# existed.
set -eu
SELF=$0
while [ -L "$SELF" ]; do
  link=$(readlink -- "$SELF")
  case $link in
    /*) SELF=$link ;;
    *)  SELF=$(dirname -- "$SELF")/$link ;;
  esac
done
HERE=$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd)
exec "$HERE/../tools/anakrisis/anakrisis.sh" "$@"
